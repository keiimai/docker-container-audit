# syntax=docker/dockerfile:1.29.0@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# --- Python の検査用のイメージ（README.md「本番の手順」）---
# --- 固定ベースと、uv・Docker の CLI・buildx（版とダイジェストで固定）---
ARG BASE_IMAGE=ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168
ARG DOCKER_CLI_IMAGE=docker:29.9.3-cli@sha256:5a7af0dcb0e46c803efe9b45371dd21cb500e5b4453250394ac6f06d49b6e6f1
ARG BUILDX_IMAGE=docker/buildx-bin:0.38.1@sha256:0b7d9e66e81dd1155639421b8342f9731f8bb67cb11b58663f938d9c6e9b6eef
ARG TARGETARCH
FROM ${UV_IMAGE} AS uv
FROM ${DOCKER_CLI_IMAGE} AS docker_cli
FROM ${BUILDX_IMAGE} AS buildx

# --- Quarto の公式の配布物（R の検査用と同じ版。アーキテクチャごとの SHA-256 で固定）---
FROM scratch AS quarto_amd64
ADD --checksum=sha256:39d2e4546274be39a27cceeeed21a60b693c4c477a8c8cb43fb34326442f3910 \
    https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.36/quarto-1.9.36-linux-amd64.tar.gz /quarto.tar.gz
FROM scratch AS quarto_arm64
ADD --checksum=sha256:6f4b2fee6be469ae038a23fe3196010f29d7716129eed2891524c1f88ad82f2f \
    https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.36/quarto-1.9.36-linux-arm64.tar.gz /quarto.tar.gz
FROM quarto_${TARGETARCH} AS quarto

# --- 検査用の本体（取得元の時点と、定義のハッシュを受け取る）---
FROM ${BASE_IMAGE}
ARG APT_SNAPSHOT=20261124T000000Z
ARG AUDIT_RUNNER_DEFINITION=unknown

# --- Docker の CLI と buildx、uv（公式のイメージから、版とダイジェストで固定して取る）---
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=buildx /buildx /usr/local/lib/docker/cli-plugins/docker-buildx
COPY --from=uv /uv /usr/local/bin/uv

# --- Python 3.12・git・証明書・時刻のデータを APT スナップショットの時点から入れ、取得元を戻す ---
RUN set -eu; \
    . /etc/os-release; \
    test "$ID:$VERSION_ID" = ubuntu:24.04; \
    apt-get -o Acquire::Retries=5 -o APT::Update::Error-Mode=any update; \
    work="$(mktemp -d /root/ca.XXXXXX)"; \
    cd "$work"; \
    apt-get download ca-certificates; \
    dpkg-deb -x ca-certificates*.deb .; \
    find usr/share/ca-certificates -name '*.crt' -exec cat {} + > /etc/apt/snapshot-ca.pem; \
    cd /; \
    rm -rf "$work"; \
    mv /etc/apt/sources.list.d/ubuntu.sources /etc/apt/ubuntu.sources.original; \
    sed "s|^URIs:.*|URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}/|; /^URIs:/a Check-Valid-Until: no" \
        /etc/apt/ubuntu.sources.original > /etc/apt/sources.list.d/ubuntu.sources; \
    printf 'Acquire::https::CaInfo "/etc/apt/snapshot-ca.pem";\n' > /etc/apt/apt.conf.d/99audit-snapshot; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get -o Acquire::Retries=5 -o APT::Update::Error-Mode=any update; \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        python3 git ca-certificates tzdata; \
    mv /etc/apt/ubuntu.sources.original /etc/apt/sources.list.d/ubuntu.sources; \
    rm -f /etc/apt/apt.conf.d/99audit-snapshot /etc/apt/snapshot-ca.pem; \
    rm -rf /var/lib/apt/lists/*; \
    git config --system --add safe.directory '*'

# --- Quarto を /opt/quarto に展開し、/usr/local/bin/quarto から使えるようにする ---
RUN --mount=type=bind,from=quarto,target=/opt/quarto-archive \
    mkdir -p /opt/quarto \
    && tar -xzf /opt/quarto-archive/quarto.tar.gz -C /opt/quarto --strip-components=1 \
    && ln -s /opt/quarto/bin/quarto /usr/local/bin/quarto \
    && docker --version \
    && docker buildx version \
    && uv --version \
    && quarto --version

# --- 操作側の Python の環境を uv.lock の版で作り、報告書の python3 カーネルを登録する ---
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy
COPY pyproject.toml uv.lock .python-version /opt/runner/
RUN uv sync --locked --project /opt/runner --python /usr/bin/python3 \
    && /opt/venv/bin/python -m ipykernel install --sys-prefix --name python3 \
    && /opt/venv/bin/python --version

# --- 検査用の中で動いている目印と、報告書が使う Python ---
ENV QUARTO_PYTHON=/opt/venv/bin/python \
    PATH="/opt/venv/bin:${PATH}" \
    AUDIT_RUNNER=python \
    AUDIT_RUNNER_DEFINITION=${AUDIT_RUNNER_DEFINITION}
