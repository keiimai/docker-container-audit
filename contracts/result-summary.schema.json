{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/result-summary.schema.json",
  "title": "result-summary.json 1.0",
  "description": "R と Python の各工程が、工程ごとの証跡のフォルダ outputs/evidence/<run_id>/<工程>/ に書く結果の共通形式。操作名と言語の組は operations.tsv に従う。",
  "type": "object",
  "required": [
    "schema_version", "language", "operation", "status", "image", "platform", "image_id",
    "os_id", "os_version", "completed_at", "message", "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "language": {"enum": ["r", "python"]},
    "operation": {
      "type": "string",
      "pattern": "^(resolve|confirm|build|audit|save)-(r|python)(-[a-z]+)*$"
    },
    "status": {"enum": ["PASS", "FAIL", "REVIEW"]},
    "image": {"type": ["string", "null"]},
    "platform": {"enum": ["linux/amd64", "linux/arm64", null]},
    "image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "os_id": {"type": ["string", "null"]},
    "os_version": {"type": ["string", "null"]},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "message": {"type": ["string", "null"]},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "base_image": {"type": ["string", "null"]},
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
